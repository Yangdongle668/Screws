{
    email {$TLS_EMAIL}
}
{$SITE_HOST} {
    encode zstd gzip
    request_body {
        max_size 12MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    reverse_proxy app:3000 {
        header_up -OAI-*
        header_up -CF-*
        header_up -X-Real-IP
        header_up X-Forwarded-For {remote_host}
    }
}
