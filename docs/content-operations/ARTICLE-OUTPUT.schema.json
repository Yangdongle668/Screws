{
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "reason",
    "publication",
    "keywordBrief",
    "seo",
    "schema",
    "article",
    "sources",
    "changeSummary",
    "uncertainties",
    "gapEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "zufek.article.v1"
    },
    "status": {
      "enum": [
        "READY_FOR_REVIEW",
        "HOLD",
        "NO_CHANGE"
      ]
    },
    "reason": {
      "type": "string"
    },
    "gapEvidence": {
      "type": "string"
    },
    "publication": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "action",
        "type",
        "targetPath"
      ],
      "properties": {
        "action": {
          "enum": [
            "new",
            "update"
          ]
        },
        "type": {
          "enum": [
            "technical",
            "insight",
            "guide"
          ]
        },
        "targetPath": {
          "type": "string"
        }
      }
    },
    "keywordBrief": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "primaryKeyword",
        "secondaryKeywords",
        "searchIntent",
        "readerQuestion",
        "coverageDecision",
        "competingPaths",
        "observedPAA"
      ],
      "properties": {
        "primaryKeyword": {
          "type": "string"
        },
        "secondaryKeywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "searchIntent": {
          "enum": [
            "informational",
            "commercial_investigation",
            "transactional"
          ]
        },
        "readerQuestion": {
          "type": "string"
        },
        "coverageDecision": {
          "enum": [
            "new_article",
            "improve_existing"
          ]
        },
        "competingPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "observedPAA": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "seo": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "title",
        "description",
        "internalLinks",
        "social"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "internalLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "label"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "social": {
          "type": "object",
          "required": [
            "title",
            "description"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    },
    "schema": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "type",
        "topics"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "BlogPosting",
            "TechArticle"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "article": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "slug",
        "path",
        "title",
        "metaTitle",
        "description",
        "category",
        "intro",
        "sections",
        "product",
        "cover",
        "bodyFormat",
        "checklist",
        "example",
        "processes",
        "sources",
        "keywords",
        "relatedLinks"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "metaTitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "product": {
          "type": "string"
        },
        "cover": {
          "type": "string"
        },
        "bodyFormat": {
          "enum": [
            "plain",
            "markdown"
          ]
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "type": "string"
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "label"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "claim"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          }
        }
      }
    },
    "changeSummary": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "summary",
        "changes",
        "preserved"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY_FOR_REVIEW"
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "type": "object"
          },
          "keywordBrief": {
            "type": "object"
          },
          "seo": {
            "type": "object"
          },
          "schema": {
            "type": "object"
          },
          "article": {
            "type": "object"
          },
          "changeSummary": {
            "type": "object"
          }
        }
      }
    }
  ]
}
